# Transient artifacts the wrappers create when run from inside a project.
# (In a consuming project, add these to that project's .gitignore too.)
.hpc_audit.log
.hpc_root_verified
.hpc_backups/

# A local hpc.env for testing the skill against a real cluster. Never commit one:
# it carries someone's host, account, and absolute project paths, and this repo
# is meant to be shared. config/hpc.env.example is the committed template.
hpc.env

# Python / OS noise
__pycache__/
*.pyc
.DS_Store
